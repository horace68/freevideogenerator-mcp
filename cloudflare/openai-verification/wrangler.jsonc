{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "freevideogenerator-openai-verification",
  "account_id": "38beeea48b96d6fabcba39f49361b6b4",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "https://freevideogenerator.app/.well-known/openai-apps-challenge*",
      "zone_name": "freevideogenerator.app"
    }
  ],
  "observability": {
    "enabled": false
  }
}
