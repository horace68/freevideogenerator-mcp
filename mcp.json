{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "freevideogenerator": {
      "type": "streamable-http",
      "url": "https://freevideogenerator.app/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://freevideogenerator.app/api/mcp",
            "baseScopes": [
              "account:read",
              "generations:read",
              "generations:write",
              "media:read",
              "media:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
